// Define a versão das regras de segurança do Firestore.
rules_version = '2';

// Define o serviço ao qual as regras se aplicam (Cloud Firestore).
service cloud.firestore {
  // Corresponde a todos os documentos em qualquer banco de dados do projeto.
  match /databases/{database}/documents {
    // Corresponde a qualquer documento na subcoleção 'tasks' de um usuário.
    // Garante que um usuário só possa ler e escrever em suas próprias tarefas.
    match /users/{userId}/tasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Corresponde a qualquer documento na coleção 'suggested_task_names'.
    // Permite que qualquer usuário autenticado leia as sugestões, mas ninguém pode escrevê-las.
    match /suggested_task_names/{suggestedTaskNameId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
